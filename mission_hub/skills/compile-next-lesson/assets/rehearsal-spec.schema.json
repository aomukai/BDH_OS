{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-spec-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rehearsal_id", "lesson_path", "lesson_sha256", "scenario_id", "random_seed", "luna", "luna_reporter", "sol", "verifier", "effort_escalation", "review_wiki_bindings", "learner_profile", "required_phases", "allowed_tools", "teacher_language_policy", "budgets", "parent_run_manifest_path", "parent_run_manifest_sha256", "repair_receipt_path", "repair_receipt_sha256"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_spec_v1"},
    "rehearsal_id": {"type": "string", "minLength": 1},
    "lesson_path": {"type": "string", "minLength": 1},
    "lesson_sha256": {"$ref": "#/$defs/sha256"},
    "scenario_id": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer", "minimum": 0},
    "luna": {"$ref": "#/$defs/luna"},
    "luna_reporter": {"$ref": "#/$defs/luna_reporter"},
    "sol": {"$ref": "#/$defs/sol"},
    "verifier": {"$ref": "#/$defs/verifier"},
    "effort_escalation": {"type": "object", "additionalProperties": false, "required": ["target_role", "ladder", "attempt_index", "current_effort", "max_failure_outcome"], "properties": {"target_role": {"enum": ["lesson_conductor", "post_lesson_analyst"]}, "ladder": {"const": ["medium", "high", "xhigh", "max"]}, "attempt_index": {"type": "integer", "minimum": 0, "maximum": 3}, "current_effort": {"enum": ["medium", "high", "xhigh", "max"]}, "max_failure_outcome": {"const": "terminal_model_capability_failure"}}},
    "review_wiki_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "learner_profile": {"$ref": "#/$defs/profile"},
    "required_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["presentation", "affirmative", "negative", "W_question", "OR_question", "reciprocity", "mixed_practice", "picture_book", "comprehension", "transfer", "closing_recap"]}},
    "allowed_tools": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "ALARM"}, "items": {"enum": ["SHOW_ASSET", "SHOW_CROP", "SHOW_HIGHLIGHT", "REPLAY_PRESENTATION", "USE_MARKERS", "ASK_BOUNDED_CLARIFICATION", "CHECK_UNDERSTANDING", "PRESENT_AGAIN", "TRAIN_MORE", "TRAIN_LONGER", "REPLAY_LESSON", "FINISH", "ALARM"]}},
    "teacher_language_policy": {"$ref": "#/$defs/language"},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_teacher_turns", "max_student_turns", "max_tool_calls"], "properties": {"max_teacher_turns": {"type": "integer", "minimum": 1, "maximum": 512}, "max_student_turns": {"type": "integer", "minimum": 1, "maximum": 512}, "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 512}}},
    "parent_run_manifest_path": {"type": ["string", "null"], "minLength": 1},
    "parent_run_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "repair_receipt_path": {"type": ["string", "null"], "minLength": 1},
    "repair_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "object", "additionalProperties": false, "required": ["role", "model_id", "reasoning_effort", "prompt_sha256"], "properties": {"role": {"type": "string"}, "model_id": {"type": "string", "minLength": 1}, "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}, "prompt_sha256": {"$ref": "#/$defs/sha256"}}},
    "luna": {"allOf": [{"$ref": "#/$defs/actor"}, {"properties": {"role": {"const": "luna_teacher"}}}]},
    "luna_reporter": {"allOf": [{"$ref": "#/$defs/actor"}, {"properties": {"role": {"const": "luna_post_lesson_analyst"}}}]},
    "sol": {"allOf": [{"$ref": "#/$defs/actor"}, {"properties": {"role": {"const": "sol_learner_simulator"}}}]},
    "verifier": {"type": "object", "additionalProperties": false, "required": ["role", "reviewer_id", "model_id", "prompt_sha256", "rubric_sha256", "context_policy"], "properties": {"role": {"const": "sol_independent_reviewer"}, "reviewer_id": {"type": "string", "minLength": 1}, "model_id": {"type": "string", "minLength": 1}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "rubric_sha256": {"$ref": "#/$defs/sha256"}, "context_policy": {"const": "fresh_context_anonymized_actors_lesson_level_script_log_and_wiki"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["conducted_sequence_number", "learner_state_artifact_id", "learner_state_path", "learner_state_sha256", "known_closure_path", "known_closure_sha256", "stage_description", "epistemic_baseline", "simulation_mode", "hidden_behavior_profile"], "properties": {"conducted_sequence_number": {"type": "integer", "minimum": 1, "maximum": 666}, "learner_state_artifact_id": {"type": "string", "minLength": 1}, "learner_state_path": {"type": "string", "minLength": 1}, "learner_state_sha256": {"$ref": "#/$defs/sha256"}, "known_closure_path": {"type": "string", "minLength": 1}, "known_closure_sha256": {"$ref": "#/$defs/sha256"}, "stage_description": {"type": "string", "minLength": 1}, "epistemic_baseline": {"$ref": "#/$defs/baseline"}, "simulation_mode": {"enum": ["calibrated_estimate", "conservative_lower_bound", "unexpected_bonus", "adversarial_pedagogical", "adversarial_protocol", "failure_injection"]}, "hidden_behavior_profile": {"type": "string", "minLength": 1}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["approximate_parameters_billion", "prior_image_exposures", "prior_word_form_exposures", "grounding_at_lesson_zero", "system_at_lesson_zero", "grammar_at_lesson_zero", "context_at_lesson_zero", "model_initialization", "encoder_training_effect", "prior_learning_treatment", "exposure_implication"], "properties": {"approximate_parameters_billion": {"const": 1.2}, "prior_image_exposures": {"const": 30000}, "prior_word_form_exposures": {"const": 3000}, "grounding_at_lesson_zero": {"const": "none"}, "system_at_lesson_zero": {"const": "none"}, "grammar_at_lesson_zero": {"const": "none"}, "context_at_lesson_zero": {"const": "none"}, "model_initialization": {"const": "random_1_2b_parameters"}, "encoder_training_effect": {"const": "can_read_siglip2_and_lfm_encoder_vectors_not_bankable_semantics"}, "prior_learning_treatment": {"const": "untrusted_bonus_never_prerequisite_without_deliberate_evidence"}, "exposure_implication": {"const": "no_meaning_or_knowledge_without_deliberate_grounded_evidence"}}},
    "language": {"type": "object", "additionalProperties": false, "required": ["known_forms", "frontier_forms", "instruction_phrases", "rescue_phrases", "comprehension_check_required", "unlicensed_language_action"], "properties": {"known_forms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "frontier_forms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "instruction_phrases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "rescue_phrases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "comprehension_check_required": {"const": true}, "unlicensed_language_action": {"const": "ALARM"}}}
  }
}
