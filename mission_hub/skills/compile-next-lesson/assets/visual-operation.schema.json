{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-visual-operation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "teaching_claims", "parent_asset_id", "output_asset_id", "prompt", "attempts", "crop_xywh", "receipt_path", "receipt_sha256", "verification"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"enum": ["reuse", "literal_crop", "highlight", "flux_generate", "flux_edit", "imagegen_generate", "imagegen_fallback"]},
    "status": {"enum": ["planned", "commissioned", "accepted", "rejected", "blocked"]},
    "teaching_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "parent_asset_id": {"type": ["string", "null"], "minLength": 1},
    "output_asset_id": {"type": "string", "minLength": 1},
    "prompt": {"type": ["string", "null"], "minLength": 1},
    "attempts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "crop_xywh": {"type": ["array", "null"], "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 4, "maxItems": 4},
    "receipt_path": {"type": ["string", "null"], "minLength": 1},
    "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_role", "decision", "claim_results", "rejection_reasons", "receipt_path", "receipt_sha256"],
      "properties": {
        "reviewer_role": {"enum": ["luna", "sol", "human"]},
        "decision": {"enum": ["pending", "accepted", "rejected"]},
        "claim_results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "passed", "evidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "evidence": {"type": "string"}}}},
        "rejection_reasons": {"type": "array", "items": {"enum": ["missing", "duplicated", "fused", "floating", "miscounted", "mislocated", "mislabeled", "identity_drift", "relation_failed", "salience_failed", "unintended_edit", "ambiguous", "mechanical_failure"]}},
        "receipt_path": {"type": ["string", "null"], "minLength": 1},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
