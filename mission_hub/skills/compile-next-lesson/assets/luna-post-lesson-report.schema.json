{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-luna-post-lesson-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rehearsal_id", "lesson_sha256", "author_role", "overall_assessment", "phase_assessment", "learner_capability_hypotheses", "remaining_difficulties", "uncertainties", "intervention_assessment", "teacher_self_critique", "alarm_assessment", "proposed_closure_changes", "next_lesson_implications", "rehearsal_nonadvancement"],
  "properties": {
    "schema_version": {"const": "ninereeds_luna_post_lesson_report_v1"},
    "rehearsal_id": {"type": "string", "minLength": 1},
    "lesson_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "author_role": {"const": "luna_post_lesson_analyst"},
    "overall_assessment": {"enum": ["achieved", "partially_achieved", "not_achieved", "indeterminate"]},
    "phase_assessment": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "learner_capability_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "remaining_difficulties": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "intervention_assessment": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "teacher_self_critique": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "alarm_assessment": {"type": "string", "minLength": 1},
    "proposed_closure_changes": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
    "next_lesson_implications": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rehearsal_nonadvancement": {"const": "hypotheses_only_no_learner_state_advance"}
  },
  "$defs": {
    "sequences": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence_event_sequences"], "properties": {"claim": {"type": "string", "minLength": 1}, "evidence_event_sequences": {"$ref": "#/$defs/sequences"}}},
    "hypothesis": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence_event_sequences", "support_level", "confidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "evidence_event_sequences": {"$ref": "#/$defs/sequences"}, "support_level": {"enum": ["independent", "scaffolded", "contradictory", "not_demonstrated"]}, "confidence": {"enum": ["low", "medium", "high"]}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["item", "proposed_state", "evidence_event_sequences", "caveat"], "properties": {"item": {"type": "string", "minLength": 1}, "proposed_state": {"enum": ["introduced", "controlled_practice_completed", "mixed_practice_completed", "unstable", "not_demonstrated"]}, "evidence_event_sequences": {"$ref": "#/$defs/sequences"}, "caveat": {"type": "string", "minLength": 1}}}
  }
}
