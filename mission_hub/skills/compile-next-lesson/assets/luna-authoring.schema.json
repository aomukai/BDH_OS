{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-luna-lesson-authoring-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "selection_packet_sha256", "actor", "model_id", "reasoning_effort", "prompt_sha256", "authority", "required_output", "forbidden"],
  "properties": {
    "schema_version": {"const": "ninereeds_luna_lesson_authoring_v1"},
    "request_id": {"type": "string", "minLength": 1},
    "selection_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"const": "luna"},
    "model_id": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"const": "author_complete_bounded_lesson_script"},
    "required_output": {
      "type": "array", "uniqueItems": true,
      "contains": {"const": "separate_affirmative_negative_W_OR_then_mixed"},
      "items": {"enum": [
        "PPP_presentation", "separate_affirmative_negative_W_OR_then_mixed", "story_or_application",
        "answer_contracts", "stopping_rules", "visual_teaching_claims", "prerequisite_usage_receipts"
      ]}
    },
    "forbidden": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {"enum": ["change_entry", "change_principal_point", "invent_prerequisite_evidence", "approve_pixels", "dispatch_training"]}
    }
  }
}
