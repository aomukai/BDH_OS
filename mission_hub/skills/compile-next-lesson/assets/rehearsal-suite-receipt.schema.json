{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-suite-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "lesson_sha256", "status", "pass_rule", "required_scenarios", "missing_scenarios", "failed_scenarios", "runs", "suite_spec_sha256"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_suite_receipt_v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "lesson_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed", "incomplete"]},
    "pass_rule": {"const": "all_required_scenarios_pass"},
    "required_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "missing_scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failed_scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "manifest_sha256", "terminal_status", "verdict_sha256", "review_packet_sha256"], "properties": {"scenario_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "terminal_status": {"enum": ["passed", "failed", "alarm_frozen"]}, "verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "review_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "suite_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
