{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-known-closure-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "learner_state_artifact_id", "lesson_evidence", "eligible_vocabulary"],
  "properties": {
    "schema_version": {"const": "ninereeds_known_closure_v1"},
    "learner_state_artifact_id": {"type": "string", "minLength": 1},
    "lesson_evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lesson_id", "state", "evidence_artifact_ids"],
        "properties": {
          "lesson_id": {"pattern": "^[LR][0-9]{3}$"},
          "state": {"enum": ["controlled_practice_completed", "mixed_practice_completed", "transferred", "retained", "stable"]},
          "evidence_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "eligible_vocabulary": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "surface", "evidence_lesson_ids", "evidence_artifact_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "evidence_lesson_ids": {"type": "array", "minItems": 1, "items": {"pattern": "^[LR][0-9]{3}$"}, "uniqueItems": true},
          "evidence_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
