{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-repair-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parent_manifest_sha256", "failure_codes", "root_causes", "changed_artifacts", "repair_rationale", "approved_by"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_repair_receipt_v1"},
    "parent_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failure_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "root_causes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["lesson_plan", "visual_material", "luna_routine", "sol_simulation", "harness", "verifier", "infrastructure", "unresolved"]}},
    "changed_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "before_sha256", "after_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "repair_rationale": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1}
  }
}
