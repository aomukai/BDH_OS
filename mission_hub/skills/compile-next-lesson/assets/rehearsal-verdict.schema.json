{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-verdict-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verifier_id", "review_packet_sha256", "decision", "dimensions", "report_disposition", "report_corrections", "failures", "notes"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_verdict_v1"},
    "verifier_id": {"type": "string", "minLength": 1},
    "review_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["pass", "fail"]},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["lesson_plan_waterproof", "point_topic_integrity", "material_scope_judgment", "structural_completeness", "picture_book_application", "luna_routine", "intervention_judgment", "teacher_self_assessment_calibration", "teacher_language_closure", "developmental_stage_fidelity", "protocol_integrity", "visual_grounding", "learner_simulation_fidelity"], "properties": {"lesson_plan_waterproof": {"type": "boolean"}, "point_topic_integrity": {"type": "boolean"}, "material_scope_judgment": {"type": "boolean"}, "structural_completeness": {"type": "boolean"}, "picture_book_application": {"type": "boolean"}, "luna_routine": {"type": "boolean"}, "intervention_judgment": {"type": "boolean"}, "teacher_self_assessment_calibration": {"type": "boolean"}, "teacher_language_closure": {"type": "boolean"}, "developmental_stage_fidelity": {"type": "boolean"}, "protocol_integrity": {"type": "boolean"}, "visual_grounding": {"type": "boolean"}, "learner_simulation_fidelity": {"type": "boolean"}}},
    "report_disposition": {"enum": ["luna_verified", "sol_reconstruction_required"]},
    "report_corrections": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failures": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "code", "event_sequence", "severity", "explanation", "repair_target"], "properties": {"category": {"enum": ["lesson_plan", "visual_material", "luna_routine", "sol_simulation", "harness", "verifier", "infrastructure", "unresolved"]}, "code": {"type": "string", "minLength": 1}, "event_sequence": {"type": ["integer", "null"], "minimum": 1}, "severity": {"enum": ["minor", "major", "critical"]}, "explanation": {"type": "string", "minLength": 1}, "repair_target": {"type": "string", "minLength": 1}}}},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
