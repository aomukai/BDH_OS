{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-cursor-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mode", "curriculum_sha256", "rehearsal_layer_sha256",
    "completed_entry_ids", "next_sequence_number", "learner_state_artifact_id",
    "learner_state_path", "learner_state_sha256", "known_closure_artifact_id",
    "known_closure_path", "known_closure_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_cursor_v1"},
    "mode": {"const": "handhold"},
    "curriculum_sha256": {"$ref": "#/$defs/sha256"},
    "rehearsal_layer_sha256": {"$ref": "#/$defs/sha256"},
    "completed_entry_ids": {"type": "array", "items": {"pattern": "^[LR][0-9]{3}$"}, "uniqueItems": true, "maxItems": 666},
    "next_sequence_number": {"type": "integer", "minimum": 1, "maximum": 667},
    "learner_state_artifact_id": {"type": "string", "minLength": 1},
    "learner_state_path": {"type": "string", "minLength": 1},
    "learner_state_sha256": {"$ref": "#/$defs/sha256"},
    "known_closure_artifact_id": {"type": "string", "minLength": 1},
    "known_closure_path": {"type": "string", "minLength": 1},
    "known_closure_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
