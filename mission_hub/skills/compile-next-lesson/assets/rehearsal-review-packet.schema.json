{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-review-packet-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rehearsal_id", "scenario_id", "actors", "learner_level", "lesson", "rehearsal_log", "teacher_language_policy", "teacher_post_lesson_report", "wiki_bindings", "review_dimensions", "alarm", "excluded_context"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_review_packet_v1"},
    "rehearsal_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "actors": {"const": {"teacher": "anonymous_teacher_model", "student_simulator": "anonymous_student_simulator_model"}},
    "learner_level": {"type": "object", "additionalProperties": false, "required": ["conducted_sequence_number", "learner_state_artifact_id", "learner_state_path", "learner_state_sha256", "known_closure_path", "known_closure_sha256", "stage_description", "epistemic_baseline"], "properties": {"conducted_sequence_number": {"type": "integer", "minimum": 1, "maximum": 666}, "learner_state_artifact_id": {"type": "string", "minLength": 1}, "learner_state_path": {"type": "string", "minLength": 1}, "learner_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "known_closure_path": {"type": "string", "minLength": 1}, "known_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stage_description": {"type": "string", "minLength": 1}, "epistemic_baseline": {"type": "object"}}},
    "lesson": {"$ref": "#/$defs/binding"},
    "rehearsal_log": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "event_count", "last_event_hash"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_count": {"type": "integer", "minimum": 1}, "last_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "teacher_language_policy": {"type": "object"},
    "teacher_post_lesson_report": {"$ref": "#/$defs/binding"},
    "wiki_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "review_dimensions": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"enum": ["lesson_plan_waterproof", "point_topic_integrity", "material_scope_judgment", "structural_completeness", "picture_book_application", "luna_routine", "intervention_judgment", "teacher_self_assessment_calibration", "teacher_language_closure", "developmental_stage_fidelity", "protocol_integrity", "visual_grounding", "learner_simulation_fidelity"]}},
    "alarm": {"type": "object", "additionalProperties": false, "required": ["frozen", "event_sequence"], "properties": {"frozen": {"type": "boolean"}, "event_sequence": {"type": ["integer", "null"], "minimum": 1}}},
    "excluded_context": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
