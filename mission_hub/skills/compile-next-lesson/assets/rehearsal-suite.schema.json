{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-lesson-rehearsal-suite-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "lesson_sha256", "required_scenarios", "runs", "pass_rule"],
  "properties": {
    "schema_version": {"const": "ninereeds_lesson_rehearsal_suite_v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "lesson_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "manifest_path", "manifest_sha256"], "properties": {"scenario_id": {"type": "string", "minLength": 1}, "manifest_path": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "pass_rule": {"const": "all_required_scenarios_pass"}
  }
}
