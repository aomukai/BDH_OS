{
  "schema_version": "ninereeds_librarian_contract_v1",
  "role": "luna_librarian",
  "commissioning_status": "design_draft_not_integrated",
  "source_registry": "mission_hub/research/sources.json",
  "wiki_root": "mission_hub/wiki",
  "triggers": {
    "pipeline": ["campaign_planning_completed"],
    "manual": ["operator_requested_ingest", "operator_requested_lint"],
    "periodic": []
  },
  "campaign_transition_handoff": {
    "prior_campaign": [
      "campaign_id",
      "campaign_contract_hash",
      "closure_or_interruption_record",
      "question_dispositions",
      "findings_and_evidence",
      "unanswered_questions"
    ],
    "planned_campaign": [
      "draft_campaign_contract",
      "mission",
      "goals",
      "goal_selection_rationale",
      "questions_to_answer",
      "candidate_comparison",
      "expected_observations_and_falsifiers"
    ],
    "planning_job": ["job_id", "planning_checklist_receipt"]
  },
  "required_actions": [
    "verify_source_identity",
    "extract_atomic_claims_and_questions",
    "reconcile_support_contradiction_and_supersession",
    "update_every_affected_page",
    "update_index",
    "append_operation_log",
    "run_lint"
  ],
  "campaign_transition_actions": [
    "record_which_prior_questions_were_answered_and_how",
    "retain_partially_answered_and_unanswered_questions",
    "record_the_new_campaign_mission_and_goals",
    "record_why_sol_selected_those_goals",
    "link_each_new_campaign_question_to_its_predecessor_evidence",
    "record_what_results_would_answer_or_falsify_each_question"
  ],
  "prohibited_actions": [
    "modify_registered_source_bytes",
    "use_a_wiki_page_as_evidence",
    "silently_resolve_source_contradictions",
    "invent_missing_campaign_evidence",
    "commission_or_select_a_campaign",
    "write_research_synthesis_outside_mission_hub/wiki"
  ],
  "provider_failures": {
    "selected_model_at_capacity": "retry_with_bounded_backoff_without_marking_source_ingest_terminal",
    "rate_limited": "retry_with_bounded_backoff_without_marking_source_ingest_terminal",
    "invalid_output": "preserve_attempt_and_retry_under_schema_policy"
  }
}
