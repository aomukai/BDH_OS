{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-sol-planning-decision-v1",
  "title": "Sol campaign planning decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "planning_job_id", "predecessor_campaign_id", "briefing_receipt",
    "question_review_artifact_ids", "checklist_receipt", "state_assessment",
    "candidate_strategies", "outcome", "decision_basis", "outcome_contract",
    "luna_handoff", "lab_projection", "authorization_status"
  ],
  "properties": {
    "schema_version": {"const": "ninereeds_sol_planning_decision_v1"},
    "planning_job_id": {"type": "string", "minLength": 1},
    "predecessor_campaign_id": {"type": ["string", "null"], "pattern": "^campaign-[0-9]{4}$"},
    "briefing_receipt": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path_or_artifact_id", "sha256", "read_status", "purpose"],
        "properties": {
          "path_or_artifact_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "read_status": {"enum": ["read", "not_applicable", "missing_blocking", "missing_nonblocking"]},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "question_review_artifact_ids": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "checklist_receipt": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step_id", "disposition", "evidence_refs", "note"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["completed_with_evidence", "not_applicable", "insufficient_evidence", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "state_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_capabilities", "known_boundaries", "unresolved_questions", "active_constraints", "available_action_ids"],
      "properties": {
        "supported_capabilities": {"$ref": "#/$defs/evidence_statements"},
        "known_boundaries": {"$ref": "#/$defs/evidence_statements"},
        "unresolved_questions": {"$ref": "#/$defs/evidence_statements"},
        "active_constraints": {"$ref": "#/$defs/evidence_statements"},
        "available_action_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "candidate_strategies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "description", "question_ids", "information_gain", "dependencies", "cost", "risk", "disposition"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "question_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "information_gain": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "cost": {"enum": ["low", "medium", "high", "unknown"]},
          "risk": {"enum": ["low", "medium", "high", "unknown"]},
          "disposition": {"enum": ["selected", "rejected", "deferred", "not_comparable"]}
        }
      }
    },
    "outcome": {"enum": ["no_campaign", "prerequisite_work", "campaign_proposal"]},
    "decision_basis": {"$ref": "#/$defs/evidence_statements"},
    "outcome_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_kind", "artifact_id", "sha256"],
      "properties": {
        "contract_kind": {"enum": ["no_campaign_record", "prerequisite_work", "campaign_goals"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "luna_handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_artifact_id", "question_review_artifact_ids", "outcome_contract_artifact_id", "requested_updates"],
      "properties": {
        "decision_artifact_id": {"type": "string", "minLength": 1},
        "question_review_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "outcome_contract_artifact_id": {"type": "string", "minLength": 1},
        "requested_updates": {"type": "array", "items": {"enum": ["question_catalogue", "campaign_catalogue", "materials", "methods", "tools", "overview"]}, "uniqueItems": true}
      }
    },
    "lab_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["headline", "outcome_label", "why", "known_unknowns", "next_step", "evidence_links"],
      "properties": {
        "headline": {"type": "string", "minLength": 1},
        "outcome_label": {"enum": ["No campaign proposed", "Preparation required", "Campaign proposed"]},
        "why": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "known_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_step": {"type": "string", "minLength": 1},
        "evidence_links": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "authorization_status": {"const": "proposed_not_authorized"}
  },
  "$defs": {
    "evidence_statements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "evidence_refs"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "campaign_proposal"}}, "required": ["outcome"]},
      "then": {"properties": {"outcome_contract": {"properties": {"contract_kind": {"const": "campaign_goals"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "prerequisite_work"}}, "required": ["outcome"]},
      "then": {"properties": {"outcome_contract": {"properties": {"contract_kind": {"const": "prerequisite_work"}}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "no_campaign"}}, "required": ["outcome"]},
      "then": {"properties": {"outcome_contract": {"properties": {"contract_kind": {"const": "no_campaign_record"}}}}}
    }
  ]
}
