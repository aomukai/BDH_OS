{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-teacher-handoff-v1",
  "title": "Bounded deterministic-script to teacher-model handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "result"],
  "properties": {
    "schema_version": {"const": "ninereeds_teacher_handoff_v1"},
    "request": {"$ref": "#/$defs/request"},
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id", "lesson_id", "target_ids", "phase", "knowledge_evidence",
        "recent_context", "teacher_question", "student_answer",
        "answer_contract", "trigger", "maximum_teacher_turns"
      ],
      "properties": {
        "handoff_id": {"type": "string", "minLength": 1},
        "lesson_id": {"type": "string", "minLength": 1},
        "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "phase": {"enum": ["presentation", "controlled_practice", "mixed_practice", "transfer", "delayed_revisit"]},
        "knowledge_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previously_taught", "prior_success_count", "last_success_artifact_id", "previous_modalities"],
          "properties": {
            "previously_taught": {"type": "boolean"},
            "prior_success_count": {"type": "integer", "minimum": 0},
            "last_success_artifact_id": {"type": ["string", "null"], "minLength": 1},
            "previous_modalities": {"type": "array", "items": {"enum": ["text", "image", "audio", "tool_trace", "other"]}, "uniqueItems": true}
          }
        },
        "recent_context": {"type": "array", "items": {"type": "string"}},
        "teacher_question": {"type": "string", "minLength": 1},
        "student_answer": {"type": "string"},
        "answer_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "invariants", "acceptable_answers", "semantic_judgment_required"],
          "properties": {
            "kind": {"enum": ["exact", "set", "relation", "structured", "open_bounded"]},
            "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "acceptable_answers": {"type": "array", "items": {"type": "string"}},
            "semantic_judgment_required": {"type": "boolean"}
          }
        },
        "trigger": {"enum": ["wrong", "partial", "contradictory", "malformed", "repeated_failure", "uncertain", "surface_imitation", "previously_mastered_failure", "unexpected_possibly_valid"]},
        "maximum_teacher_turns": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis", "intervention_path", "turns_used", "outcome",
        "highest_scaffolding_used", "recovered", "presentation_required",
        "immediate_retest_required", "delayed_revisit_recommended",
        "verifier_required", "return_control", "transcript_artifact_id"
      ],
      "properties": {
        "diagnosis": {"enum": ["knowledge_absent", "retrieval_failure", "unstable_memory", "relation_reversal", "nearby_concept_confusion", "surface_pattern_dependence", "paraphrase_failure", "composition_failure", "modality_transfer_failure", "execution_failure_despite_understanding", "insufficient_contextual_support", "malformed_response", "unexpected_but_possibly_valid", "off_topic", "indeterminate"]},
        "intervention_path": {"type": "array", "items": {"enum": ["echo_suspicious_fragment", "minimal_cue", "forced_choice", "known_analogy", "partial_completion", "stepwise_reconstruction", "explicit_correction", "concept_representation"]}},
        "turns_used": {"type": "integer", "minimum": 0, "maximum": 12},
        "outcome": {"enum": ["recovered_with_minimal_cue", "recovered_with_forced_choice", "recovered_with_analogy", "recovered_with_stepwise_reconstruction", "required_explicit_correction", "presentation_required", "failed_after_intervention", "defer_and_revisit"]},
        "highest_scaffolding_used": {"type": ["string", "null"], "enum": [null, "echo_suspicious_fragment", "minimal_cue", "forced_choice", "known_analogy", "partial_completion", "stepwise_reconstruction", "explicit_correction", "concept_representation"]},
        "recovered": {"type": "boolean"},
        "presentation_required": {"type": "boolean"},
        "immediate_retest_required": {"type": "boolean"},
        "delayed_revisit_recommended": {"type": "boolean"},
        "verifier_required": {"const": true},
        "return_control": {"const": "deterministic_script"},
        "transcript_artifact_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
