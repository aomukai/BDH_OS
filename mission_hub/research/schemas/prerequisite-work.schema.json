{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-prerequisite-work-v1",
  "title": "Ninereeds prerequisite work request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "planning_job_id", "status", "category",
    "need", "why_needed", "blocked_research_question_ids", "source_inputs",
    "constraints", "deliverables", "acceptance_criteria", "quality_checks",
    "completion_evidence_roles", "followup", "authorization_status"
  ],
  "properties": {
    "schema_version": {"const": "ninereeds_prerequisite_work_v1"},
    "request_id": {"type": "string", "pattern": "^prep-[0-9]{4}-[0-9]{2,}$"},
    "planning_job_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["requested", "in_progress", "completed", "superseded", "cancelled"]},
    "category": {
      "enum": [
        "material_acquisition", "material_transformation", "evaluation_development",
        "tool_development", "infrastructure", "source_ingest", "other"
      ]
    },
    "need": {"type": "string", "minLength": 1},
    "why_needed": {"type": "string", "minLength": 1},
    "blocked_research_question_ids": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "source_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_input"}
    },
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/constraint"}
    },
    "deliverables": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/deliverable"}
    },
    "acceptance_criteria": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "quality_checks": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "completion_evidence_roles": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "followup": {"const": "return_to_sol_for_replanning"},
    "authorization_status": {"const": "proposed_not_authorized"}
  },
  "$defs": {
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "role", "availability", "freeze_before_execution"],
      "properties": {
        "kind": {
          "enum": ["library_path", "source_id", "artifact_id", "image_registry_query", "reference_asset", "other"]
        },
        "reference": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "availability": {"enum": ["verified_available", "unresolved", "missing_to_create"]},
        "freeze_before_execution": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "library_path"}}, "required": ["kind"]},
          "then": {"properties": {"freeze_before_execution": {"const": true}}}
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirement", "reference_inputs"],
      "properties": {
        "kind": {
          "enum": ["identity_continuity", "temporal_continuity", "location_continuity", "caption_alignment", "style_consistency", "coverage", "other"]
        },
        "requirement": {"type": "string", "minLength": 1},
        "reference_inputs": {
          "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "description", "format", "minimum_quantity", "quantity_unit"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "minimum_quantity": {"type": ["integer", "null"], "minimum": 1},
        "quantity_unit": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
