[Unit]
Description=Ninereeds image review queue worker (OpenRouter Gemma 4 26B)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/Ninereeds/.env
ExecStart=/usr/bin/python3 -m image_benchmark.queue_worker_api --queue visual-corpus-review-v1 --worker-id openrouter-01 --backend openrouter --endpoint https://openrouter.ai/api/v1/chat/completions --token-env OPENROUTER_API_KEY --model google/gemma-4-26b-a4b-it --max-claims 4 --disable-thinking --require-valid-schema
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
