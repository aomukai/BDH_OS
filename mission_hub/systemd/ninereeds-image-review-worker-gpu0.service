[Unit]
Description=Ninereeds image review queue worker (trainbox GPU 0)
After=ninereeds-trainbox-image-review-api.service
Requires=ninereeds-trainbox-image-review-api.service

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m image_benchmark.queue_worker_api --queue visual-corpus-review-v1 --worker-id trainbox-gpu0 --backend llama.cpp-q4km-gpu0 --endpoint http://127.0.0.1:8792/v1/chat/completions --health-endpoint http://127.0.0.1:8792/health --model gemma-4-26b-a4b-it-q4km --max-claims 4 --max-attempts 6 --disable-thinking --require-valid-schema
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
