[Unit]
Description=Ninereeds authenticated vision API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ninereeds/releases/trainbox/current
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/ninereeds-vision/bin/python -m meta.scripts.vision_api --config %h/.local/share/ninereeds/releases/trainbox/current/config/mission_hub --bind 127.0.0.1 --port 8781 --token-file %h/.local/share/ninereeds/trainbox-agent/vision-api.token
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ninereeds/trainbox-agent

[Install]
WantedBy=default.target
