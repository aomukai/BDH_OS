[Unit]
Description=Campaign 36 duplicate-lexicon review with local Gemma
After=network-online.target ninereeds-trainbox-image-review-api.service
Wants=network-online.target ninereeds-trainbox-image-review-api.service

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m image_registry.campaign36_lexicon_revision gemma
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
