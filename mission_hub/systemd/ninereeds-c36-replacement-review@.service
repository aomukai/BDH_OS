[Unit]
Description=Campaign 36 exact-sense replacement reviewer %i
After=network-online.target ninereeds-trainbox-image-review-api.service

[Service]
Type=simple
WorkingDirectory=/home/aomukai/Ninereeds
EnvironmentFile=/home/aomukai/Ninereeds/.env
ExecStart=/home/aomukai/Ninereeds/meta/scripts/campaign36_replacement_review_worker.sh %i
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
