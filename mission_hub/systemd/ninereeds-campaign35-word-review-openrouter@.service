[Unit]
Description=Campaign 35 target-aware image review (OpenRouter worker %i)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/Ninereeds/.env
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m image_benchmark.campaign35_word_worker --queue campaign35-word-semantic-review-v2 --worker-id campaign35-openrouter-%i --backend openrouter --endpoint https://openrouter.ai/api/v1/chat/completions --token-env OPENROUTER_API_KEY --model google/gemma-4-26b-a4b-it --max-claims 2 --max-attempts 20 --disable-thinking --require-valid-schema
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
