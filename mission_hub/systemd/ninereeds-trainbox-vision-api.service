[Unit]
Description=Ninereeds private trainbox vision API tunnel supervisor
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -o ExitOnForwardFailure=yes -L 127.0.0.1:8781:127.0.0.1:8781 -- ninereeds-trainbox-agent vision-api
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
