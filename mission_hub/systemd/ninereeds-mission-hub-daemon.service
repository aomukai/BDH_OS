[Unit]
Description=Ninereeds Mission Hub scheduler and dispatcher
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ninereeds/releases/mission-hub/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/ninereeds/mission-hub.env
EnvironmentFile=-%h/Ninereeds/.env
ExecStart=/usr/bin/python3 -m mission_hub --config config/mission_hub daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ninereeds/mission-hub %h/.codex %h/Ninereeds/.git

[Install]
WantedBy=default.target
