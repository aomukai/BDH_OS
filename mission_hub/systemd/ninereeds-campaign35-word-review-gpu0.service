[Unit]
Description=Campaign 35 target-aware image review (trainbox GPU 0)
After=ninereeds-trainbox-image-review-api.service
Requires=ninereeds-trainbox-image-review-api.service

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m image_benchmark.campaign35_word_worker --queue campaign35-word-semantic-review-v2 --worker-id campaign35-trainbox-gpu0 --backend llama.cpp-q4km-gpu0 --endpoint http://127.0.0.1:8792/v1/chat/completions --health-endpoint http://127.0.0.1:8792/health --model gemma-4-26b-a4b-it-q4km --max-claims 4 --max-attempts 6 --disable-thinking --require-valid-schema
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
