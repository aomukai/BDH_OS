[Unit]
Description=Ninereeds dual-GPU Gemma image review API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ninereeds/releases/trainbox/current
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m meta.scripts.image_review_api --state-root %h/.local/share/ninereeds/trainbox-agent
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ninereeds/trainbox-agent

[Install]
WantedBy=default.target
