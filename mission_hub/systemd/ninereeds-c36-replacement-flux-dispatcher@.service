[Unit]
Description=Campaign 36 replacement Flux dispatcher GPU %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aomukai/Ninereeds
ExecStart=/home/aomukai/.venvs/ninereeds-cortex/bin/python -m image_registry.campaign36_replacement_flux_dispatcher --db /home/aomukai/Ninereeds/training_data/image_registry/registry.sqlite3 --worker-id c36-flux-%i --gpu %i --remote-root /mnt/ninereeds-runtime/visual/campaign36-replacement-flux-v1/gpu%i --attempts-per-needed 3 --loop
Restart=on-failure
RestartSec=20
