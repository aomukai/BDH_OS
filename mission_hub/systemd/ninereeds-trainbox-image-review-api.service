[Unit]
Description=Ninereeds private dual-GPU image review API tunnels
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -L 127.0.0.1:8792:127.0.0.1:8792 -L 127.0.0.1:8793:127.0.0.1:8793 -- ninereeds-trainbox
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
