[Unit]
Description=Campaign 36 isolated headless Codex ImageGen fallback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m image_registry.campaign36_headless_imagegen --workers 8 --limit 8 --loop
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillMode=control-group
Nice=5

[Install]
WantedBy=default.target
