[Unit]
Description=Campaign 35 Luna watermark adjudication worker %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Ninereeds
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.venvs/ninereeds-cortex/bin/python -m image_benchmark.luna_watermark_worker --source-queue campaign35-word-semantic-review-v2 --queue campaign35-word-watermark-luna-v1 --worker-id campaign35-luna-watermark-%i --lease-seconds 1800 --timeout 600
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
