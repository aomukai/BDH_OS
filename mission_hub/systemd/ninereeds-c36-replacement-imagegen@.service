[Unit]
Description=Campaign 36 replacement GPT Image worker %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aomukai/Ninereeds
ExecStart=/home/aomukai/.venvs/ninereeds-cortex/bin/python -m image_registry.campaign36_replacement_imagegen_worker --db /home/aomukai/Ninereeds/training_data/image_registry/registry.sqlite3 --worker-id c36-imagegen-%i --attempts-per-needed 3 --loop
Restart=on-failure
RestartSec=20
