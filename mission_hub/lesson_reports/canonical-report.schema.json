{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds-canonical-lesson-outcome-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "lesson_id", "conducted_sequence_number", "run_id", "run_kind", "lesson", "point", "topic", "tested_items", "actor_efforts", "report_authority", "luna_report", "event_log", "sol_verdict", "outcome", "capabilities", "difficulties", "uncertainties", "failure_tags", "world_knowledge", "review_recommendations", "prerequisite_implications", "supersedes_report_id"],
  "properties": {
    "schema_version": {"const": "ninereeds_canonical_lesson_outcome_report_v1"},
    "report_id": {"type": "string", "minLength": 1},
    "lesson_id": {"pattern": "^[LR][0-9]{3}$"},
    "conducted_sequence_number": {"type": "integer", "minimum": 1, "maximum": 666},
    "run_id": {"type": "string", "minLength": 1},
    "run_kind": {"enum": ["rehearsal", "live"]},
    "lesson": {"$ref": "#/$defs/binding"},
    "point": {"type": "object", "additionalProperties": false, "required": ["id", "claim"], "properties": {"id": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}}},
    "topic": {"type": "string", "minLength": 1},
    "tested_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor_efforts": {"type": "object", "additionalProperties": false, "required": ["lesson_builder", "lesson_conductor", "post_lesson_analyst"], "properties": {"lesson_builder": {"enum": ["low", "medium", "high", "xhigh", "max"]}, "lesson_conductor": {"enum": ["low", "medium", "high", "xhigh", "max"]}, "post_lesson_analyst": {"enum": ["low", "medium", "high", "xhigh", "max"]}}},
    "report_authority": {"enum": ["luna_verified", "sol_reconstructed"]},
    "luna_report": {"$ref": "#/$defs/binding"},
    "event_log": {"$ref": "#/$defs/binding"},
    "sol_verdict": {"$ref": "#/$defs/binding"},
    "outcome": {"enum": ["passed", "failed", "alarm_frozen", "indeterminate"]},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "difficulties": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "world_knowledge": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "review_recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prerequisite_implications": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "supersedes_report_id": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["claim", "status", "evidence_event_sequences", "confidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "status": {"enum": ["independent", "scaffolded", "unstable", "not_demonstrated", "failed"]}, "evidence_event_sequences": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}, "confidence": {"enum": ["low", "medium", "high"]}}}
  }
}
