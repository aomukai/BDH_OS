{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/lab_message_v1.schema.json",
  "title": "Ninereeds Lab message envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "created_at",
    "sender",
    "recipient",
    "kind",
    "title",
    "body",
    "correlation_id",
    "reply_to",
    "content_sha256",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "lab_message_v1"},
    "message_id": {"type": "string", "pattern": "^(msg|reply)-[A-Za-z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "sender": {"type": "string", "minLength": 1},
    "recipient": {"type": "string", "minLength": 1},
    "kind": {"enum": ["user_message", "codex_reply", "system_notice"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "body": {"type": "string", "minLength": 1, "maxLength": 65536},
    "correlation_id": {"type": ["string", "null"]},
    "reply_to": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata": {"type": "object"}
  }
}
