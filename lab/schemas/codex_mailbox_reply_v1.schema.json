{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/codex_mailbox_reply_v1.schema.json",
  "title": "Codex mailbox reply",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "subject",
    "body",
    "requires_interactive"
  ],
  "properties": {
    "disposition": {
      "type": "string",
      "enum": [
        "answered",
        "needs_interactive",
        "rejected"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "requires_interactive": {
      "type": "boolean"
    }
  }
}
