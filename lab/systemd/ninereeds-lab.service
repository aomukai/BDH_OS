[Unit]
Description=Ninereeds Lab workstation control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aomukai/Ninereeds
ExecStart=/usr/bin/python3 -m lab.backend.server --host 0.0.0.0 --port 8765
Environment=PYTHONUNBUFFERED=1
Environment=LAB_GIT_EXPECTED_REMOTE=origin
Environment=LAB_GIT_EXPECTED_BRANCH=main
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
