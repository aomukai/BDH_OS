{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/workflows/material-workflow/v1",
  "type": "object",
  "required": ["campaign_id", "units", "corpus"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["unit_id", "specification", "input_artifact_ids", "output_contract", "limits"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "specification": {"type": "object", "additionalProperties": true},
          "input_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "output_contract": {"type": "object", "additionalProperties": true},
          "limits": {
            "type": "object",
            "required": ["max_output_items"],
            "properties": {
              "max_output_items": {"type": "integer", "minimum": 1, "maximum": 16}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "corpus": {
      "type": "object",
      "required": ["corpus_name"],
      "properties": {
        "corpus_name": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
