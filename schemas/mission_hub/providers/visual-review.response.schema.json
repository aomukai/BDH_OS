{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["asset_sha256", "asset_status", "accepted_uses", "visible_facts", "uncertainty", "reason"],
  "properties": {
    "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_status": {"enum": ["usable", "unusable"]},
    "accepted_uses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "visible_facts": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
