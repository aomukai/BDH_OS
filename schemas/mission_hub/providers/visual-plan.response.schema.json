{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["plan_id", "teaching_goal", "canonical_text", "items", "provenance_requirements"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "teaching_goal": {"type": "string", "minLength": 1},
    "canonical_text": {"type": "array", "items": {"type": "string"}},
    "items": {"type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object",
      "required": ["item_id", "prompt", "canonical_caption", "seeds", "width", "height", "steps", "guidance_scale"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 12000},
        "canonical_caption": {"type": "string", "minLength": 1, "maxLength": 4096},
        "seeds": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
        "width": {"type": "integer", "minimum": 64, "maximum": 4096},
        "height": {"type": "integer", "minimum": 64, "maximum": 4096},
        "steps": {"type": "integer", "minimum": 1, "maximum": 200},
        "guidance_scale": {"type": "number", "minimum": 0, "maximum": 30}
      },
      "additionalProperties": false
    }},
    "provenance_requirements": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
