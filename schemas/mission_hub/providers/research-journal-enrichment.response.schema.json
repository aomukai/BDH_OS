{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/providers/research-journal-enrichment-response/v1",
  "type": "object",
  "required": ["keywords", "summary"],
  "properties": {
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9._:-]*$"
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200}
  },
  "additionalProperties": false
}
