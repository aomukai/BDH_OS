{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/providers/operations-response/v1",
  "type": "object",
  "required": ["disposition", "action", "assessment", "reasoning", "target_job_id"],
  "properties": {
    "disposition": {"enum": ["no_action_needed", "automatic_recovery", "repaired", "operator_required"]},
    "action": {"enum": ["no_action", "allow_automatic_recovery", "retry_failed_job", "pause_pipeline", "operator_required"]},
    "assessment": {"type": "string", "minLength": 1, "maxLength": 16000},
    "reasoning": {"type": "string", "maxLength": 16000},
    "target_job_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
