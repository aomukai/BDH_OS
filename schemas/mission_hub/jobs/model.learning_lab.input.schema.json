{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/model-learning-lab-input/v1",
  "type": "object",
  "required": [
    "width",
    "rotary_pairs",
    "sequence_length",
    "training_examples",
    "evaluation_examples",
    "training_steps",
    "black_swan_steps",
    "common_replay_steps",
    "disconnected_cells",
    "learning_rate",
    "minimum_heldout_improvement_fraction",
    "seed",
    "device_indices",
    "dtype"
  ],
  "properties": {
    "width": {"type": "integer", "minimum": 8, "maximum": 4096},
    "rotary_pairs": {"type": "integer", "minimum": 1, "maximum": 256},
    "sequence_length": {"type": "integer", "minimum": 2, "maximum": 512},
    "training_examples": {"type": "integer", "minimum": 2, "maximum": 4096},
    "evaluation_examples": {"type": "integer", "minimum": 2, "maximum": 4096},
    "training_steps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "black_swan_steps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "common_replay_steps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "disconnected_cells": {"type": "integer", "minimum": 0, "maximum": 100000},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_heldout_improvement_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "device_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 7}
    },
    "dtype": {"enum": ["float32", "bfloat16"]}
  },
  "additionalProperties": false
}
