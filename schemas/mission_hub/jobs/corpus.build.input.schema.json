{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/corpus-build-input/v1",
  "type": "object",
  "required": ["corpus_name", "source_paths", "normalization", "record_format"],
  "properties": {
    "corpus_name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "source_paths": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalization": {"const": "utf8_lf"},
    "record_format": {"const": "ninereeds_document_v1"}
  },
  "additionalProperties": false
}
