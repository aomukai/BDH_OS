{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/system.artifact-roundtrip-output/v1",
  "type": "object",
  "required": ["status", "artifacts", "metrics", "failure"],
  "properties": {
    "status": {"const": "succeeded"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "sha256", "byte_size", "uri", "lifecycle", "manifest"],
        "properties": {
          "kind": {"const": "commissioning_receipt"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1},
          "uri": {"type": "string"},
          "lifecycle": {"const": "observed"},
          "manifest": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": ["input_bytes", "input_sha256"],
      "properties": {
        "input_bytes": {"type": "integer", "minimum": 0},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "failure": {"type": "null"}
  },
  "additionalProperties": false
}
