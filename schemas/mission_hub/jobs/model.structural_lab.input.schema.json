{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/model-structural-lab-input/v1",
  "type": "object",
  "required": [
    "width",
    "rotary_pairs",
    "sequence_length",
    "benchmark_warmup",
    "benchmark_iterations",
    "page_capacity",
    "maximum_composite_leaves",
    "behavior_tolerance",
    "maximum_seam_regression",
    "seed",
    "device_indices",
    "dtype"
  ],
  "properties": {
    "width": {"type": "integer", "minimum": 8, "maximum": 4096},
    "rotary_pairs": {"type": "integer", "minimum": 1, "maximum": 256},
    "sequence_length": {"type": "integer", "minimum": 2, "maximum": 512},
    "benchmark_warmup": {"type": "integer", "minimum": 0, "maximum": 1000},
    "benchmark_iterations": {"type": "integer", "minimum": 1, "maximum": 10000},
    "page_capacity": {"type": "integer", "minimum": 2, "maximum": 10000},
    "maximum_composite_leaves": {"type": "integer", "minimum": 2, "maximum": 256},
    "behavior_tolerance": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "maximum_seam_regression": {"type": "number", "minimum": 0.0, "maximum": 100.0},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "device_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 7}
    },
    "dtype": {"enum": ["float32", "bfloat16"]}
  },
  "additionalProperties": false
}
