{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/campaign-decide-output/v1",
  "type": "object",
  "required": ["status", "action", "rationale", "evidence_ids", "assumptions", "artifacts"],
  "properties": {
    "status": {"enum": ["succeeded", "blocked"]},
    "action": {"type": "object", "additionalProperties": true},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
