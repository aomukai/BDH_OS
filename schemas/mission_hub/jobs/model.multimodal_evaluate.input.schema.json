{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/model-multimodal-evaluate-input/v1",
  "type": "object",
  "required": ["input_artifact_ids", "branch_id", "parameters"],
  "properties": {
    "input_artifact_ids": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "branch_id": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object",
      "required": ["ingress_device", "core_device", "max_new_tokens"],
      "properties": {
        "ingress_device": {"type": "string"},
        "core_device": {"type": "string"},
        "max_new_tokens": {"type": "integer", "minimum": 1, "maximum": 256}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
