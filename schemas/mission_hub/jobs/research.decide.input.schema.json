{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/research-decide-input/v1",
  "type": "object",
  "required": ["lab_id", "campaign_id", "campaign_number", "activation_id", "goal", "todo", "observation", "recent_reports", "available_datasets", "allowed_actions", "campaign_journal"],
  "properties": {
    "lab_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_number": {"type": "integer", "minimum": 1},
    "activation_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1, "maxLength": 16384},
    "todo": {"type": "object", "additionalProperties": true},
    "observation": {"type": "object", "additionalProperties": true},
    "recent_reports": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["sender", "body", "created_at"],
        "properties": {
          "sender": {"type": "string"},
          "body": {"type": "string", "maxLength": 65536},
          "created_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "available_datasets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "modality", "format", "byte_size", "sha256", "constraints"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["builtin_bootstrap", "research_dataset", "corpus"]},
          "modality": {"enum": ["multimodal", "text", "image_text"]},
          "format": {"type": "string", "minLength": 1},
          "byte_size": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {"type": "string", "minLength": 1},
          "constraints": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["wait", "inspect_state", "ask_for_advice", "acquire_dataset", "launch_experiment", "modify_code", "conclude_campaign"]}
    },
    "campaign_journal": {
      "type": "object",
      "required": ["schema_version", "uri", "sha256", "byte_size", "experiment_count"],
      "properties": {
        "schema_version": {"const": "ninereeds_research_campaign_journal_v1"},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "experiment_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
