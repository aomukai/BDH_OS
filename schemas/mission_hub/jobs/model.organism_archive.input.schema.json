{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ninereeds://mission-hub/jobs/model-organism-archive-input/v1",
  "type": "object",
  "required": [
    "launch_run_id",
    "source_release_id",
    "snapshot_name",
    "shared_sha256",
    "archive_name"
  ],
  "properties": {
    "launch_run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_release_id": {
      "type": "string",
      "pattern": "^release-[0-9a-f]{12}-[0-9a-f]{12}$"
    },
    "snapshot_name": {"const": "session-30"},
    "shared_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_name": {
      "type": "string",
      "pattern": "^campaign36c-original-visual-only-[0-9]{8}\\.zip$"
    }
  },
  "additionalProperties": false
}
