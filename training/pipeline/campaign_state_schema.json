{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/autonomous_campaign_state_v1.json",
  "title": "Ninereeds autonomous campaign state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "status",
    "mode",
    "objective",
    "created_at",
    "updated_at",
    "deadline_at",
    "seed_plan_id",
    "root_boundary_plan_id",
    "current_plan_id",
    "boundary_index",
    "authorization",
    "allowed_child_kinds",
    "allowed_phase_ids",
    "context_files",
    "budgets",
    "usage",
    "stop_reason",
    "history"
    ,"governance"
  ],
  "properties": {
    "schema_version": {"const": "ninereeds_autonomous_campaign_v1"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$"},
    "status": {"enum": ["running", "waiting", "paused", "completed", "blocked"]},
    "mode": {"enum": ["shadow", "live"]},
    "objective": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "seed_plan_id": {"type": "string", "minLength": 1},
    "root_boundary_plan_id": {"type": ["string", "null"]},
    "current_plan_id": {"type": "string", "minLength": 1},
    "boundary_index": {"type": "integer", "minimum": 0},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_weight_updates",
        "allow_checkpoint_promotion",
        "allow_auto_advance"
      ],
      "properties": {
        "allow_weight_updates": {"type": "boolean"},
        "allow_checkpoint_promotion": {"type": "boolean"},
        "allow_auto_advance": {"type": "boolean"}
      }
    },
    "allowed_child_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["phase_block", "executor_job"]}
    },
    "allowed_phase_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["phase_0_form", "phase_1_word_form"]}
    },
    "context_files": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategic_boundaries",
        "phase_blocks",
        "executor_jobs",
        "trainer_sessions"
      ],
      "properties": {
        "strategic_boundaries": {"type": "integer", "minimum": 1, "maximum": 1000},
        "phase_blocks": {"type": "integer", "minimum": 0, "maximum": 1000},
        "executor_jobs": {"type": "integer", "minimum": 0, "maximum": 1000},
        "trainer_sessions": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategic_boundaries",
        "phase_blocks",
        "executor_jobs",
        "trainer_sessions"
      ],
      "properties": {
        "strategic_boundaries": {"type": "integer", "minimum": 0},
        "phase_blocks": {"type": "integer", "minimum": 0},
        "executor_jobs": {"type": "integer", "minimum": 0},
        "trainer_sessions": {"type": "integer", "minimum": 0}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending_directive", "last_review_id", "last_reviewed_mutations"],
      "properties": {
        "pending_directive": {"type": ["string", "null"]},
        "last_review_id": {"type": ["string", "null"]},
        "last_reviewed_mutations": {"type": "integer", "minimum": 0}
      }
    },
    "stop_reason": {"type": ["string", "null"]},
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "status", "detail"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "status": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
