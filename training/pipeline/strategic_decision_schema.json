{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/strategic_decision_v1.json",
  "title": "Ninereeds strategic decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "rationale",
    "user_message",
    "child_plan_json"
  ],
  "properties": {
    "action": {
      "enum": [
        "enqueue_plan",
        "wait",
        "request_human"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "user_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 12000
    },
    "child_plan_json": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 131072
    }
  }
}
