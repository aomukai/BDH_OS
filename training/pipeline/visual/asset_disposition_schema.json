{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/visual_asset_disposition_v1.json",
  "title": "NineReeds visual asset disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "asset_sha256", "display_filename", "review_status",
    "commission_status", "asset_status", "actual_facts", "potential_uses",
    "failure_reason", "evidence", "assistant", "sol_review"
  ],
  "properties": {
    "schema_version": {"const": "ninereeds_visual_asset_disposition_v1"},
    "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "display_filename": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["assistant_proposal", "sol_verified"]},
    "commission_status": {"enum": ["fulfilled", "partially_fulfilled", "failed"]},
    "asset_status": {"enum": ["usable", "review", "unusable"]},
    "actual_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "evidence_keys"],
        "properties": {
          "fact": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_keys": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "potential_uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["teaching_goal", "kind", "requires_assets", "constraints", "evidence_facts"],
        "properties": {
          "teaching_goal": {"type": "string", "minLength": 1, "maxLength": 500},
          "kind": {
            "enum": [
              "cardinality_label", "comparative_series_member", "increment_or_decrement_pair",
              "count_question", "descriptive_sentence", "contrastive_negative"
            ]
          },
          "requires_assets": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_facts": {"type": "array", "items": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "failure_reason": {"type": ["string", "null"], "maxLength": 1000},
    "evidence": {"type": "object"},
    "assistant": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "role"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "role": {"const": "proposal_only"}
      }
    },
    "sol_review": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer", "accepted_use_indexes", "verified_evidence_keys", "reason"],
          "properties": {
            "reviewer": {"const": "sol"},
            "accepted_use_indexes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
            "verified_evidence_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      ]
    }
  }
}
