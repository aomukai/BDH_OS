{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["concerns", "questions", "recommendation"],
  "properties": {
    "concerns": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "questions": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "recommendation": {"enum": ["approve", "challenge"]}
  }
}
