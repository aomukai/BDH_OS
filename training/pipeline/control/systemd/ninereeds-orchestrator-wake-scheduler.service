[Unit]
Description=Check whether Ninereeds orchestration is due
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/aomukai/Ninereeds
ExecStart=/usr/bin/python3 -m training.pipeline.control.orchestrator_wake_scheduler
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/aomukai/.local/state/ninereeds-orchestrator-control
