{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/cortex_curriculum_chunk_v1.json",
  "title": "Cortex curriculum authoring chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chunk_index", "examples"],
  "properties": {
    "schema_version": {"const": "ninereeds_cortex_curriculum_chunk_v1"},
    "chunk_index": {"type": "integer", "minimum": 1},
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "completion", "stage"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1, "maxLength": 512},
          "completion": {"type": "string", "minLength": 1, "maxLength": 256},
          "stage": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    }
  }
}
