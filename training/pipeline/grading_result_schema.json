{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/msm_grading_result_v1.json",
  "title": "MSM Executor Grading Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "script_id",
    "item_grades",
    "recommended_action",
    "next_focus",
    "failure_modes",
    "requires_orchestrator",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "msm_grading_result_v1"},
    "session_id": {"type": "string", "minLength": 1},
    "script_id": {"type": "string", "minLength": 1},
    "item_grades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "original_status",
          "after_correction_status",
          "malformed",
          "repetition_collapse",
          "rationale",
          "confidence"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "original_status": {
            "enum": ["correct", "wrong_on_topic", "wrong_off_topic", "ungradable"]
          },
          "after_correction_status": {
            "enum": [
              "correct",
              "wrong_on_topic",
              "wrong_off_topic",
              "ungradable",
              "not_applicable"
            ]
          },
          "malformed": {"type": "boolean"},
          "repetition_collapse": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "recommended_action": {
      "enum": [
        "PASS_AUTONEXT",
        "PASS_BUT_BUFFER",
        "RETRY_SAME_WORD",
        "ESCALATE_ORCHESTRATOR",
        "ESCALATE_HUMAN",
        "REJECT"
      ]
    },
    "next_focus": {
      "type": "array",
      "items": {"type": "string"}
    },
    "failure_modes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requires_orchestrator": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1}
  }
}
