{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninereeds.local/schemas/executor_response_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "job_id",
    "attempt",
    "status",
    "reasoning_summary",
    "assumptions",
    "artifacts",
    "requested_actions",
    "expected_validation",
    "risk_flags"
  ],
  "properties": {
    "protocol_version": {"const": "ninereeds_executor_v1"},
    "job_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {
      "enum": [
        "SUCCESS",
        "NEEDS_VALIDATION",
        "NEEDS_MORE_CONTEXT",
        "RETRYABLE_FORMAT_ERROR",
        "RETRYABLE_MODEL_ERROR",
        "UNSUPPORTED_JOB",
        "POLICY_REJECTED",
        "VALIDATION_FAILED",
        "EXECUTION_FAILED"
      ]
    },
    "reasoning_summary": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        }
      }
    },
    "requested_actions": {
      "type": "array",
      "items": {
        "enum": [
          "VALIDATE_JSON",
          "RUN_TESTS",
          "RETURN_VALIDATION_ERRORS",
          "NONE"
        ]
      }
    },
    "expected_validation": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risk_flags": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}

