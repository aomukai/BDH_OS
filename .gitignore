.env
.env.*
!.env.example
CLAUDE.md
docs/handoff_*.md

# Model weights and checkpoints are machine-local artifacts, never source.
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
core/msm/
core/cortex/
runs/
__pycache__/
*.pyc
loras/**/*.pt
.claude/
claude/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Training inputs and frozen campaign payloads are operator-owned data on
# Mission Hub. Git tracks contracts and tooling, never corpora or assets.
training_data/
config/mission_hub/campaign_material/**
!config/mission_hub/campaign_material/README.md
training/corpus/
training/corpus_admin/
inventory/
training_data/phases/venv/

# Generated numerical stores and local databases.
*.npy
*.npz
*.parquet
*.arrow
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
nul
temp.patch
patch1.diff
filelist.*
chat/
!lab/backend/chat/
!lab/backend/chat/**
!lab/frontend/chat/
!lab/frontend/chat/**
lab/messages/
lab/state/
lab/published/
lab/**/__pycache__/
training/pipeline/msm/control/
training/pipeline/msm/phase_blocks/
training/pipeline/msm/sessions/
training/pipeline/msm/updates/
training/pipeline/msm/logs/
handoff/

# Historical source/data snapshots are retained locally and in Mission Hub
# evidence, but are not part of executable source releases.
archive/

# Temporary outputs (audit logs are kept)
tmp/
!tmp/audit_*.jsonl

# Training corpus build artifacts (regenerate with build_training_corpus.py)
training/corpus/*.txt

# Reports, maps, logs, and campaign publications are runtime evidence. Mission
# Hub indexes/captures them; Git no longer transports the mutable directory.
training/logs/

# Legacy controller state and prepared campaign blocks are evidence/artifacts,
# not backend source or authoritative control state.
training/pipeline/msm/state/
training/pipeline/cortex/allowlist_waves/

# Promoted run checkpoints (large binary weights, local-only)
checkpoints/
